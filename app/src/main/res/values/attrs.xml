<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 自定义控件 TitleBar 的自定义属性 -->
    <declare-styleable name="TitleBar">
        <!-- 标题文字 -->
        <attr name="tbTitle" format="string" />
        <!-- 是否显示左上角的返回按钮 -->
        <attr name="tbShowBack" format="boolean" />
    </declare-styleable>

</resources>
